{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blackbox run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "repository_revision", "repository_dirty", "config_hash", "configuration", "package_versions", "platform", "python", "gatekeeper_manifest", "policy_hash", "metadata_hash", "attack_file_hash", "invocation_hash", "pending_behavior", "seeds", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "repository_revision": {"type": "string"},
    "repository_dirty": {"type": "boolean"},
    "config_hash": {"type": "string"},
    "configuration": {"type": "object"},
    "package_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "platform": {"type": "string"},
    "python": {"type": "string"},
    "gatekeeper_manifest": {"type": "object"},
    "policy_hash": {"type": "string"},
    "metadata_hash": {"type": "string"},
    "attack_file_hash": {"type": ["string", "null"]},
    "invocation_hash": {"type": "string"},
    "pending_behavior": {"const": "terminal_no_resume"},
    "seeds": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
